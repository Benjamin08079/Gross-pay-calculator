   "source": [
    "# Gross pay calculator with overtime."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b8d515a4-2fff-4019-befe-3cc1bfaf7f2c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter Hours: 45\n",
      "Enter Rate: 10.50\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Pay: 498.75\n"
     ]
    }
   ],
   "source": [
    "hours=input(\"Enter Hours:\")\n",
    "rate=input(\"Enter Rate:\")\n",
    "hours=float(hours)\n",
    "rate=float(rate)\n",
    "\n",
    "if hours>40:\n",
    "    regular=40*rate\n",
    "    overtime=(hours-40)*rate*1.5\n",
    "    Pay=regular+overtime\n",
    "else:\n",
    "    Pay=hours*rate\n",
    "print(\"Pay:\",Pay)"
   ]
  },
